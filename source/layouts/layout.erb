<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= current_page.data.title || "Fighting Club Meran/o" %></title>
    <meta name="description" content="<%= t(:tagline) %>">
    <meta name="viewport" content="width=device-width">
    <%= stylesheet_link_tag "main" %>
    <%= favicon_tag 'assets/img/favicon.ico' %>
  </head>

  <body class="<%= page_classes %>">
    <div class="topbar">
      <div class="container">
        <ul class="language-menu">
          <li><%= nav_link "Deutsch", "/", locale: :de %></li>
          <li><%= nav_link "Italiano", "/it/", locale: :it %></li>
          <li><%= nav_link "English", "/en/", locale: :en %></li>
        </ul>
      </div>
    </div>
    <div class="container">
      <header>
        <nav class="main-menu">
          <ul>
            <li><%= nav_link t(:section_classes), "index.html#classes", :class => 'anchor-link' %></li>
            <li><%= nav_link t(:section_trainers), "index.html#trainers", :class => 'anchor-link' %></li>
            <li><%= nav_link t(:section_schedule), "index.html#schedule", :class => 'anchor-link' %></li>
            <li><%= nav_link t(:section_join), "index.html#join", :class => 'anchor-link' %></li>
            <li><%= nav_link t(:section_contact), "index.html#contact", :class => 'anchor-link' %></li>
            <li class="mobile-only">
              <a href="#!" class="language"><%= t(:language_switch) %></a>
              <ul class="language-menu">
                <li><%= nav_link "Deutsch", "/", locale: :de %></li>
                <li><%= nav_link "Italiano", "/it/", locale: :it %></li>
                <li><%= nav_link "English", "/en/", locale: :en %></li>
              </ul>
            </li>
          </ul>
        </nav>
        <a class="main-logo" id="main-logo" href="index.html#topbar">
          <img src="../assets/img/logo-v2.png" alt="Fighting Club Meran/o">
        </a>
      </header>
      <%= yield %>
    </div>
    <footer>
      <div class="overlay">
        <div class="container">
          <section class="content_wrapper" id="contact">
            <div class="section-header contact-info">
              <div class="zen-box two-col-1">
                <h2><%= t(:section_contact) %></h2>
              </div>
            </div>
            <div class="section-header contact-info">
              <div class="zen-box two-col-1">
                <p class="title-descriptions">
                  <%= t(:desc_contact) %>
                </p>
                <a class="contact-email" href="mailto:fightingclub2006@gmail.com">fightingclub2006@gmail.com</a>
                <%# <p class="contact-phone">+39 338 2445844</p> %>
                <a class="contact-fb" href="https://www.facebook.com/FightingClubMerano" target="_blank"><img src="../assets/img/fb-icon.svg" alt="Logo Facebook"><%= t(:fb_follow) %></a>
                <div class="contact-address">
                  Fighting Club Meran/o<br>
                  <%= t(:desc_contactaddress) %><br>
                  <br>
                  Banca per il Trentino - Alto Adige<br>
                  IBAN: IT02R0830458490000054000293
                </div>
              </div>
              <div class="zen-box two-col-2">
                <h3><%= t(:subsection_partners) %></h3>
                <p class="title-descriptions">
                  <%= t(:subdesc_partners) %>
                </p>
<!--                <a class="partner-link" target="_blank" href="https://booncon.com"><img src="../assets/img/logo_bc-inverted.svg" alt="Logo booncon" /></a>  -->
                <a class="partner-link" target="_blank" href="https://www.lasplendidaaltoatesina.com"><img src="../assets/img/la_splendida_altoatesina_inverted.svg" alt="Logo La Splendida Altoatesina" /></a>
                <a class="partner-link" target="_blank" href="https://www.protactics.de"><img src="../assets/img/logo_ProTactics.svg" alt="Logo I.P.F." /></a>
<!--                <a class="partner-link" target="_blank" href="http://torggler.com"><img src="../assets/img/logo_torggler.svg" alt="Logo Torggler" /></a> -->
                <a class="partner-link invert-svg resize-svg" target="_blank" href="https://www.ufficiocamerale.it/4759/painttec-des-morina-sami"><img src="../assets/img/logo_painttec.svg" alt="Logo Painttec" /></a>


              </div>
            </div>
          </section>
          <div class="content_wrapper">
            <div class="zen-box credit-line"><span class="copy-link">© <%= Time.now.year %> FightingClub Meran/o | <%= nav_link t(:section_credits), "credits.html" %></span> | Crafted by <a href="https://booncon.com" target="_blank" class="credit-link">booncon</a></div>
          </div>
        </div>
      </div>
    </footer>
    <%= javascript_include_tag "vendor/jquery-3.7.1.min" %>
    <%= javascript_include_tag "vendor/jquery.meanmenu" %>
    <%= javascript_include_tag "vendor/slippry.min" %>
    <%= javascript_include_tag "main" %>
  </body>
</html>
